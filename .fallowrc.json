{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.23.0",
  "entry": [
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "scripts/**/*.ts"
  ],
  "ignoreExports": [
    {
      "file": "src/lib/components/ui/**",
      "exports": [
        "*"
      ]
    }
  ],
  "audit": {
    "gate": "new-only"
  }
}
